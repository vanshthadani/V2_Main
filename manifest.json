{

        "name" : "StudyFlow",
        "version" : "1.0",
        "manifest_version" : 3,
        "description":"Helps Users Study better with the help of Artificial Intelligence",
    

    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": [
            "tooltip.js",
            "content.js"
        ],
        "css": ["styles.css"]
    },
    {
        "matches": ["https://www.youtube.com/*"],
        "js": [
            "youtube.js"
        ],
        "css": ["styles.css"]
    },
    {
        "matches": ["https://www.netflix.com/*"],
        "js": [
            "netflix.js"
        ],
        "css": ["styles.css"]
    }


    ],

    "background" :{
        "service_worker" : "background.js",
        "type": "module"
    },
    "action" :{
        "default_popup" : "popup.html"
    },


    "permissions": [
        "storage"
    ]

}

